# Public site URL used for metadataBase, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://cdf.studio

# Optional social profile URLs (override defaults)
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cdf_dance_school/
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@childancefactory
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/CDF.danceschool
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@childancefactory

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=childancefactory@gmail.com

# Sender address (use onboarding@resend.dev until you verify your domain)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Comma-separated last names allowed to checkout (server-only; case-insensitive)
# Example: CHECKOUT_LAST_NAMES=Smith,Johnson,Lee
CHECKOUT_LAST_NAMES=

# Production maintenance gate (on by default in production builds).
# Local `next dev` is never gated unless this is true. Set to false on Vercel when ready to launch:
# MAINTENANCE_MODE=false
# MAINTENANCE_MODE=true

# Server-only preview bypass on /maintenance ("Have a secret code?").
# Leave empty to keep the public on the maintenance page with no unlock.
MAINTENANCE_PREVIEW_CODE=
